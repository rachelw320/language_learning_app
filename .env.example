# Copy to .env. Never commit .env.
# VITE_API_URL is read by the app in the browser (set it in the netlify dashboard too). The rest are read by the cdk app at
# deploy time and put on the lambda, and the AWS_ ones just need to be whatever `aws configure` set up.

# The api - printed as ApiUrl by npm run infra:deploy. Without it the app just uses the cards bundled in src/data/cards.json
VITE_API_URL=https://xxxxxxxxxx.execute-api.eu-west-2.amazonaws.com

# Where the app is served from, for cors
APP_ORIGIN=https://your-site.netlify.app

# What the admin screen asks for before it lets you add cards
ADMIN_PASSWORD=pick_something_long

# Elevenlabs - used by scripts/generate-audio.js locally and by the tts route on the lambda
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_ARABIC_VOICE_ID=your_egyptian_arabic_voice_id
