# Copy to .env for local development (npm run dev). Never commit .env.
# The VITE_ ones are read by the app in the browser, the rest only by the scripts and netlify functions.

# Supabase - optional, without these the app just uses the cards bundled in src/data/cards.json
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Elevenlabs - used by scripts/generate-audio.js and the tts netlify function (set these in the netlify dashboard too)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_ARABIC_VOICE_ID=your_egyptian_arabic_voice_id

# Openai - only for the whisper function, which the app doesn't call yet
OPENAI_API_KEY=sk-...
