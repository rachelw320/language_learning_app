{
	"name": "language-learning-app",
	"version": "0.1.0",
	"private": true,
	"description": "Egyptian arabic flashcards with typed answers, spaced repetition and audio for every card. React and typescript on netlify, with a lambda, aurora and s3 backend defined in cdk.",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"infra:synth": "cdk synth --quiet",
		"infra:deploy": "cdk deploy --outputs-file cdk-outputs.json",
		"infra:destroy": "cdk destroy",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx scripts/db-migrate.ts",
		"db:seed": "tsx scripts/db-seed.ts",
		"generate-audio": "node scripts/generate-audio.js"
	},
	"dependencies": {
		"@aws-sdk/client-rds-data": "^3.1140.0",
		"@aws-sdk/client-s3": "^3.1140.0",
		"@aws-sdk/s3-request-presigner": "^3.1140.0",
		"drizzle-orm": "^0.45.3",
		"hono": "^4.13.9",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@types/aws-lambda": "^8.10.163",
		"@types/node": "^26.6.2",
		"@types/react": "^18.3.1",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^4.3.1",
		"autoprefixer": "^10.4.20",
		"aws-cdk": "^2.1143.0",
		"aws-cdk-lib": "^2.270.0",
		"constructs": "^10.8.1",
		"dotenv": "^16.4.5",
		"drizzle-kit": "^0.31.11",
		"esbuild": "^0.28.2",
		"postcss": "^8.4.47",
		"prettier": "^3.9.9",
		"tailwindcss": "^3.4.14",
		"tsx": "^4.23.15",
		"typescript": "^5.5.3",
		"vite": "^5.4.8",
		"vitest": "^3.2.7"
	}
}
